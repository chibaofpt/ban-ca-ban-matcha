{
  "name": "ban-ca-ban-matcha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:maplibre-assets": "node scripts/sync-maplibre-assets.mjs",
    "images:backfill:staging": "dotenv -e .env.staging -- node scripts/backfill-menu-images.cjs",
    "dev": "npm run sync:maplibre-assets && next dev --turbopack",
    "dev:staging": "npm run sync:maplibre-assets && dotenv -e .env.staging -- next dev --turbopack",
    "dev:prod": "npm run sync:maplibre-assets && dotenv -e .env.prod -- next dev --turbopack",
    "dev:webpack": "npm run sync:maplibre-assets && next dev --webpack",
    "dev:staging:webpack": "npm run sync:maplibre-assets && dotenv -e .env.staging -- next dev --webpack",
    "dev:prod:webpack": "npm run sync:maplibre-assets && dotenv -e .env.prod -- next dev --webpack",
    "build": "npm run sync:maplibre-assets && prisma generate && prisma migrate deploy && next build",
    "build:staging": "npm run sync:maplibre-assets && dotenv -e .env.staging -- prisma generate && dotenv -e .env.staging -- prisma migrate deploy && dotenv -e .env.staging -- next build",
    "build:prod": "npm run sync:maplibre-assets && dotenv -e .env.prod -- prisma generate && dotenv -e .env.prod -- prisma migrate deploy && dotenv -e .env.prod -- next build",
    "start": "next start",
    "lint": "eslint",
    "resources:check": "node scripts/check-resources.mjs",
    "test": "vitest run",
    "test:live:staging:plan": "dotenv -o -e .env.staging -e .env.staging.local -- node scripts/staging-tests/cli.mjs plan",
    "test:live:staging:smoke": "dotenv -o -e .env.staging -e .env.staging.local -- node scripts/staging-tests/cli.mjs smoke",
    "test:live:staging:full": "dotenv -o -e .env.staging -e .env.staging.local -- node scripts/staging-tests/cli.mjs full",
    "test:live:staging:recover": "dotenv -o -e .env.staging -e .env.staging.local -- node scripts/staging-tests/cli.mjs recover",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "migrate:dev": "dotenv -e .env.staging -- prisma migrate dev",
    "migrate:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "migrate:prod": "dotenv -e .env.prod -- prisma migrate deploy"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@turf/circle": "^7.3.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "antd": "^6.3.3",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "html5-qrcode": "^2.3.8",
    "input-otp": "^1.4.2",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "maplibre-gl": "^6.0.0",
    "next": "16.3.0",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.72.1",
    "react-resizable-panels": "^4.7.6",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/ui": "^4.1.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}

# ============================================================
# CẤU TRÚC BIẾN MÔI TRƯỜNG - LƯU Ý CHO DEVELOPER MỚI
# ============================================================
# File này chỉ liệt kê tên biến và được phép commit.
# Sao chép sang .env.local rồi điền giá trị thật tại local.
# Không điền secret hoặc dữ liệu thật vào file example này.

# 1. BIẾN SHARED (Sử dụng chung mọi môi trường)
STORE_LAT=
STORE_LNG=
BANK_ID=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
GOONG_API_KEY=
NEXT_PUBLIC_GOONG_MAPTILES_KEY=

# 2. BIẾN PER-ENV (Staging/Production - Tự động fill theo môi trường)
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Preferred server-only Storage/Data API credential.
SUPABASE_SECRET_KEY=
# One-release legacy fallback only; remove after every environment uses SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
CRON_SECRET=
IMAGE_CLEANUP_DRY_RUN=true

# 3. REDIS (Upstash) - security rate-limit exception only before Phase 5; not app caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 4. SMS (eSMS) - Phase 5
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_SANDBOX=

# 5. STAGING LIVE TEST (both .env.staging and .env.staging.local must exist; local loads last/wins)
# TEST_STAGING_CONFIG_DIR is an optional absolute directory pointer supplied ONLY in the process
# environment before file loading; setting it inside either env file has no effect.
# Only the five nonsecret project/team/branch/pooler-host/release-window pins may overlay from process env;
# secrets remain in the ignored env files.
# TEST_BASE_URL/TEST_DEPLOYMENT_ID/TEST_DEPLOYMENT_SHA are profile outputs derived from attestation;
# do not use manually entered values as trusted profile targets.
TEST_BASE_URL=
PRODUCTION_BASE_URL=
TEST_STAGING_SUPABASE_REF=
TEST_STAGING_POOLER_HOST=
TEST_STAGING_CONFIG_DIR=
TEST_VERCEL_PROJECT_ID=
TEST_VERCEL_TEAM_ID=
TEST_VERCEL_GIT_BRANCH=
TEST_RELEASE_WINDOW_ID=
TEST_DEPLOYMENT_ID=
TEST_DEPLOYMENT_SHA=
TEST_MAX_RUNTIME_MINUTES=60
PUSH_DELIVERY_MODE=
TEST_CUSTOMER_A_PHONE=
TEST_CUSTOMER_A_PASSWORD=
TEST_CUSTOMER_B_PHONE=
TEST_CUSTOMER_B_PASSWORD=
TEST_ADMIN_PHONE=
TEST_ADMIN_PASSWORD=
TEST_STAFF_PHONE=
TEST_STAFF_PASSWORD=

# 6. SENTRY (same project/DSN, set APP_ENV per deployment)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_APP_ENV=staging
# report-only (Preview/Staging) | enforce (Production after clean report review) | off (emergency only)
CSP_MODE=report-only
